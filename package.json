{
  "name": "github-automation-mcp",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "MCP server in TypeScript for common GitHub operations.",
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/server.ts",
    "inspect": "npm run build && npx @modelcontextprotocol/inspector node dist/server.js",
    "start": "node dist/server.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "tsc --noEmit"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.17.5",
    "@octokit/rest": "^22.0.0",
    "dotenv": "^17.2.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.15.30",
    "@vitest/coverage-v8": "^3.2.7",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  }
}
